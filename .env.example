# ---- Application ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
APP_TIMEZONE=Asia/Kolkata

# ---- MongoDB (replica set REQUIRED for transactions; see ops/docker/compose.dev.yml) ----
MONGO_URI=mongodb://localhost:27017/sfm?replicaSet=rs0&directConnection=true

# ---- Redis (BullMQ, cache, rate-limit) ----
REDIS_URL=redis://localhost:6379

# ---- Auth (Phase 2) — generate with: openssl rand -base64 48 ----
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me-change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Browser origins allowed to call the API (comma separated). Leave empty when the SPA is served from the same origin.
CORS_ORIGINS=http://localhost:5173

# ---- First-run bootstrap: `pnpm --filter @sfm/api db:seed` ----
# Creates the institution, built-in roles and the first Super Admin. Without a password a one-time temporary
# password is generated and printed (the user must change it at first sign-in).
SEED_ADMIN_EMAIL=admin@school.example
SEED_ADMIN_PASSWORD=

# ---- Object storage (S3-compatible; MinIO locally) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sfm-dev
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ---- Observability ----
SENTRY_DSN=
