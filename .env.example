# ---- Application ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
APP_TIMEZONE=Asia/Kolkata

# ---- MongoDB (replica set REQUIRED for transactions; see ops/docker/compose.dev.yml) ----
MONGO_URI=mongodb://localhost:27017/sfm?replicaSet=rs0&directConnection=true

# ---- Redis (BullMQ, cache, rate-limit) ----
REDIS_URL=redis://localhost:6379

# ---- Auth (Phase 2) — generate with: openssl rand -base64 48 ----
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me-change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# ---- Object storage (S3-compatible; MinIO locally) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sfm-dev
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ---- Observability ----
SENTRY_DSN=
